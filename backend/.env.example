# KALYCE v2 — example env (NEVER commit secrets)
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.kalyce.bf
DJANGO_SECRET_KEY=replace-me
DB_NAME=kalyce
DB_USER=kalyce
DB_PASSWORD=kalyce
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/0
FIELD_ENCRYPTION_KEY=replace-base64-32-bytes
HSZ_SIGNING_KEY=replace-hex-32-bytes
AUDIT_SIGNING_KEY=replace-hex-32-bytes
OTP_SALT_KEY=replace-hex-32-bytes
IDEMPOTENCY_TTL=86400
QUORUM_XOF_THRESHOLD=500000
SECRET_KEY=KALYCE
SOC_WEBHOOK_URL=https://soc.kalyce.bf/ingest
SENTRY_DSN=
KEY_ROTATION_INTERVAL_DAYS=90
CORS_ALLOWED_ORIGINS=https://app.kalyce.bf

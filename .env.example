# =============================================================================
# KALYCE · Modèle d'environnement (§21.5 du CDC)
# Copiez en .env puis lancez « make secrets » : les valeurs marquées GÉNÉRÉE
# sont produites localement. Aucun secret réel ne doit entrer dans le dépôt.
#
# Colonne « PROD » :
#   OBLIGATOIRE = le démarrage échoue si la variable manque ou est factice
#                 (config/settings/guards.py — R7, fail fast).
#   REQUISE     = nécessaire au fonctionnement complet de la fonctionnalité.
#   OPTIONNELLE = valeur par défaut sûre acceptable.
# =============================================================================

# --------------------------------------------------------------- Django (socle)
DJANGO_SETTINGS_MODULE=config.settings.dev      # PROD: OBLIGATOIRE (config.settings.prod)
DJANGO_ENV=dev                                  # PROD: OBLIGATOIRE (production)
KALYCE_ENVIRONMENT=dev                          # PROD: OBLIGATOIRE (production)
DJANGO_DEBUG=true                               # PROD: OBLIGATOIRE = false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1        # PROD: OBLIGATOIRE (api.kalyce.bf)
DJANGO_SECRET_KEY=replace-me-run-make-secrets   # PROD: OBLIGATOIRE · GÉNÉRÉE · ≥ 50 caractères
CORS_ALLOWED_ORIGINS=http://localhost:5173      # PROD: OBLIGATOIRE (https://app.kalyce.bf)

# ------------------------------------------------------------------ Base de données
DB_NAME=kalyce                                  # PROD: OBLIGATOIRE
DB_USER=kalyce                                  # PROD: OBLIGATOIRE (rôle propriétaire, migrations uniquement)
DB_PASSWORD=kalyce                              # PROD: OBLIGATOIRE · secret géré hors dépôt
DB_HOST=postgres                                # PROD: OBLIGATOIRE
DB_PORT=5432                                    # PROD: OBLIGATOIRE
DB_TEST_NAME=test_kalyce                        # PROD: inutilisée
# Rôle applicatif NOBYPASSRLS : sans lui, la RLS est contournée (P0-06).
DB_APP_USER=kalyce_app                          # PROD: OBLIGATOIRE
DB_APP_PASSWORD=kalyce_app                      # PROD: OBLIGATOIRE · secret géré hors dépôt

# --------------------------------------------------------------- Redis / Celery
REDIS_URL=redis://redis:6379/0                  # PROD: OBLIGATOIRE
CELERY_BROKER_URL=redis://redis:6379/1          # PROD: REQUISE
CELERY_RESULT_BACKEND=redis://redis:6379/2      # PROD: REQUISE

# ------------------------------------------------------------------- Cryptographie
FIELD_ENCRYPTION_KEY=replace-me-run-make-secrets  # PROD: OBLIGATOIRE · GÉNÉRÉE · base64 32 octets
HSZ_SIGNING_KEY=replace-me-run-make-secrets       # PROD: OBLIGATOIRE · GÉNÉRÉE · hex 64 caractères
AUDIT_SIGNING_KEY=replace-me-run-make-secrets     # PROD: OBLIGATOIRE · GÉNÉRÉE · hex 64 caractères
OTP_SALT_KEY=replace-me-run-make-secrets          # PROD: OBLIGATOIRE · GÉNÉRÉE · hex 64 caractères
KEY_ROTATION_INTERVAL_DAYS=90                     # PROD: OPTIONNELLE
# Interdit hors développement : le garde-fou refuse le démarrage s'il est vrai.
KALYCE_ALLOW_INSECURE_DEV_KEYS=true               # PROD: DOIT ÊTRE ABSENT
KALYCE_DEV_KEY_SEED=kalyce-dev                    # PROD: DOIT ÊTRE ABSENT

# --------------------------------------------------------------------- WebAuthn
WEBAUTHN_RP_ID=localhost                          # PROD: OBLIGATOIRE (kalyce.bf)
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:5173    # PROD: OBLIGATOIRE (https://app.kalyce.bf)
QUORUM_XOF_THRESHOLD=500000                       # PROD: REQUISE
QUORUM_MIN_APPROVERS=2                            # PROD: REQUISE

# ------------------------------------------------------------------ Idempotence
IDEMPOTENCY_TTL=86400                             # PROD: REQUISE
IDEMPOTENCY_LOCK_TTL=30                           # PROD: REQUISE

# --------------------------------------------------------------- Paiements (agrégateurs)
# Adaptateurs simulés : strictement interdits en production (P0-07).
PAYMENTS_ALLOW_SIMULATED_ADAPTERS=true            # PROD: DOIT ÊTRE false/absent
AGGREGATOR_ORANGE_API_KEY=                        # PROD: REQUISE
AGGREGATOR_ORANGE_WEBHOOK_SECRET=                 # PROD: REQUISE
AGGREGATOR_WAVE_API_KEY=                          # PROD: REQUISE
AGGREGATOR_WAVE_WEBHOOK_SECRET=                   # PROD: REQUISE
AGGREGATOR_MOOV_API_KEY=                          # PROD: REQUISE
AGGREGATOR_MOOV_WEBHOOK_SECRET=                   # PROD: REQUISE

# ------------------------------------------------------------------- Stockage S3
S3_ENDPOINT_URL=http://minio:9000                 # PROD: REQUISE
S3_BUCKET=kalyce-media                            # PROD: REQUISE
AWS_ACCESS_KEY_ID=kalyce-minio                    # PROD: REQUISE
AWS_SECRET_ACCESS_KEY=kalyce-minio-dev            # PROD: REQUISE · secret géré hors dépôt
MINIO_ROOT_USER=kalyce-minio                      # dev uniquement
MINIO_ROOT_PASSWORD=kalyce-minio-dev              # dev uniquement

# ------------------------------------------------------------------------ E-mail
EMAIL_HOST=mailhog                                # PROD: REQUISE
EMAIL_PORT=1025                                   # PROD: REQUISE

# --------------------------------------------------------- Observabilité (R10)
SERVICE_NAME=kalyce-api                           # PROD: REQUISE
LOG_LEVEL=INFO                                    # PROD: REQUISE
PROMETHEUS_METRICS_ENABLED=true                   # PROD: REQUISE
METRICS_TOKEN=replace-me-run-make-secrets         # PROD: OBLIGATOIRE · GÉNÉRÉE
SENTRY_DSN=                                       # PROD: REQUISE
SOC_WEBHOOK_URL=                                  # PROD: REQUISE
RISK_GLOBAL_ESCALATION_USERS=                     # PROD: OPTIONNELLE

# ------------------------------------------------------------------------ Divers
TZ=UTC                                            # PROD: OBLIGATOIRE — UTC partout
OTP_ARGON2_TIME_COST=3                            # PROD: OPTIONNELLE
OTP_ARGON2_MEMORY_COST=65536                      # PROD: OPTIONNELLE
OTP_ARGON2_PARALLELISM=2                          # PROD: OPTIONNELLE
KALYCE_DB_WAIT_SECONDS=60                         # PROD: OPTIONNELLE
